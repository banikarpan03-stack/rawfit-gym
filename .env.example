# RAWfit Gym — environment variables
#
# Copy to `.env` for local development, or set them in Render's Environment tab.
# The server reads process.env directly; there is no dotenv dependency, so on
# Linux/macOS use `export $(cat .env | xargs) --` or your process manager's env
# file. On Render, set them in the dashboard (Settings → Environment).

# --- Runtime -----------------------------------------------------------------
# Port the HTTP server binds to. Render sets this for you.
#PORT=3000

# production enables HSTS and the stricter CORS allow-list below.
NODE_ENV=production

# --- Database ----------------------------------------------------------------
# Leave unset to run on local SQLite (file at data/gym.db). Set it to use
# PostgreSQL (Neon in production) — the driver switches automatically.
#DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Postgres TLS verification. Defaults to false to match the original deployment;
# once you have confirmed the certificate chain validates against your endpoint,
# set this to true to stop disabling certificate verification.
PG_SSL_REJECT_UNAUTHORIZED=false

# SQLite file path (local development / tests only). Defaults to data/gym.db.
#SQLITE_PATH=./data/gym.db

# --- Security ----------------------------------------------------------------
# JWT signing secret. If unset, a random secret is generated once and stored in
# the app_settings table so sessions survive restarts and the value never lands
# in git. Set it explicitly if you want to control or rotate it.
#JWT_SECRET=

# Password for the seeded admin account (phone 9999999999). If unset, "admin"
# is used and a warning is logged — set this before your first production deploy
# or change the password from the admin panel afterwards.
#ADMIN_PASSWORD=

# Comma-separated allowed browser origins. Required in production if you want to
# restrict CORS; unset means any origin is allowed.
#CORS_ORIGINS=https://your-domain.example

# --- Gym ---------------------------------------------------------------------
# Geofence used for member check-in (haversine, metres).
GYM_LAT=22.944691
GYM_LON=88.5377882
GYM_RADIUS=100

# IANA timezone used for every "today" boundary (attendance, revenue, expiry).
GYM_TZ=Asia/Kolkata

# --- Rate limiting -----------------------------------------------------------
# Defaults are sensible for a single gym; raise them if several staff share one
# NAT and hit the login cap.
#RATE_LIMIT_WINDOW_MS=300000
#RATE_LIMIT_MAX=600
#LOGIN_RATE_LIMIT_WINDOW_MS=900000
#LOGIN_RATE_LIMIT_MAX=10
#LOGIN_RATE_LIMIT_IP_MAX=50